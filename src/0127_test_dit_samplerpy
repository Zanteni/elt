# ============================================================
# Fake DiT
# ============================================================

class FakeDiT(nn.Module):

    def forward(self, x, t):
        return x



# ============================================================
# Fake Diffusion
# ============================================================

class FakeDiffusion:


    def sample(
        self,
        model,
        shape,
        sampler,
        num_steps,
        guidance_scale,
        eta,
        device,
    ):

        print("Diffusion sample called")

        print("shape:", shape)
        print("sampler:", sampler)
        print("steps:", num_steps)


        return torch.randn(
            shape,
            device=device
        )



# ============================================================
# Fake VAE decoder
# ============================================================

class FakeVAE:


    def eval(self):
        pass


    def decoder(self, z):

        print(
            "Decoder input:",
            z.shape
        )

        B = z.shape[0]

        return torch.randn(
            B,
            3,
            32,
            32,
            device=z.device
        )



# ============================================================
# Config
# ============================================================

cfg = DiTSamplingConfig(

    diffusion=DiffusionSamplingConfig(

        enabled=True,

        num_images=8,

        batch_size=8,

        sampler="ddim",

        num_steps=50,

        guidance_scale=1.0,

        eta=0.0,
    )
)



# ============================================================
# Build sampler
# ============================================================


sampler = DiTSampler(

    cfg=cfg,

    model=FakeDiT(),

    vae=FakeVAE(),

    diffusion=FakeDiffusion(),

    device="cpu",

    shape=(8,64,4),

)



# ============================================================
# Generate
# ============================================================

outputs = sampler.generate()



print(outputs.keys())


images = outputs["diffusion"]["images"]


print(
    "Images:",
    images.shape
)



# ============================================================
# Checks
# ============================================================

assert images.shape == (
    8,
    3,
    32,
    32
)


assert torch.isfinite(images).all()



print("=" * 70)
print("DIT SAMPLER TEST PASSED")
print("=" * 70)